#!/usr/bin/env bash
#
# agent - miniagent's launcher: loads your settings, then runs agent.py.
#
# Your exports live in ~/.miniagent/env, next to policy.json and trusted.json.
# Anything already set in your shell wins over that file, so a one-off
#
#     AGENT_MODEL=MiniMax-M2.5-highspeed agent ~/code/proj
#
# still does what it says.
#
set -euo pipefail

CONFIG_DIR="${MINIAGENT_HOME:-$HOME/.miniagent}"
ENV_FILE="${MINIAGENT_ENV:-$CONFIG_DIR/env}"
PYTHON="${MINIAGENT_PYTHON:-python3}"

# Where this script really lives, following the symlink `--install` leaves on
# PATH.  `readlink -f` is not portable, so walk the chain by hand.
SELF=${BASH_SOURCE[0]}
case $SELF in
    /*) ;;
    # absolute first, or `--install` would link to a relative path from $bindir
    *) SELF=$(cd -P "$(dirname "$SELF")" && pwd)/$(basename "$SELF") ;;
esac
while [ -L "$SELF" ]; do
    target=$(readlink "$SELF")
    case $target in
        /*) SELF=$target ;;
        *)  SELF=$(cd -P "$(dirname "$SELF")" && pwd)/$target ;;
    esac
done
HERE=$(cd -P "$(dirname "$SELF")" && pwd)

die() { printf 'agent: %s\n' "$*" >&2; exit 1; }

[ -f "$HERE/agent.py" ] || die "cannot find agent.py next to $SELF"


usage() {
    cat <<'EOF'
usage: agent [wrapper option] | [agent option] [directory]

wrapper options
  --install [bindir]   symlink onto your PATH (default ~/.local/bin), then
                       ask for endpoint, model and key if they are not set yet
  --init               ask for endpoint, model and key, and save them
  --env                print the path of the settings file
                       (edit it with: $EDITOR "$(agent --env)")

everything else is passed straight to agent.py:
EOF
}


interactive() { [ -t 0 ] && [ -t 1 ]; }


shq() {                                 # a value the settings file can hold verbatim
    printf "'"
    printf '%s' "$1" | sed "s/'/'\\\\''/g"
    printf "'"
}


mask() {
    case $1 in
        # A whole value that is a command is a reference to the secret, not the
        # secret. Anything else is masked, even if it happens to contain `$(`.
        '$('*')'|'`'*'`') printf '%s' "$1" ;;
        *) if [ ${#1} -le 8 ]; then printf '****'
           else printf '%s...%s' "${1:0:4}" "${1: -4}"; fi ;;
    esac
}


# Read a setting out of the file rather than sourcing it. Sourcing would run
# whatever the value is - `$(pass show ...)` and friends - which prompts for a
# passphrase in the middle of an install, and reads as "no key" when the store
# is locked or missing. So the quoting is undone here instead, the way the
# shell would read it, without running anything.
from_file() {
    [ -f "$ENV_FILE" ] || return 1
    MA_NAME=$1 awk -v q="'" '
        function unquote(v,   c, i, out) {
            sub(/^[ \t]+/, "", v)
            if (v == "") return ""
            c = substr(v, 1, 1)
            if (c == q || c == "\"") {
                i = length(v)
                while (i > 1 && substr(v, i, 1) != c) i--
                if (i > 1) {
                    out = substr(v, 2, i - 2)
                    if (c == q) gsub(q "\\\\" q q, q, out)   # '"'"'\'"'"''"'"' is one quote
                    return out
                }
            }
            # unquoted: `#` only starts a comment after whitespace, so a value
            # like sk-live#42 keeps its hash, as it would when sourced
            if (match(v, /[ \t]+#/)) v = substr(v, 1, RSTART - 1)
            sub(/[ \t]+$/, "", v)
            return v
        }
        $0 ~ "^[ \t]*(export[ \t]+)?" ENVIRON["MA_NAME"] "=" {
            line = $0
            sub(/^[^=]*=/, "", line)
            value = unquote(line)          # the last assignment wins, as when sourced
            seen = 1
        }
        END { if (seen && value != "") { print value; exit 0 } exit 1 }
    ' "$ENV_FILE"
}


env_has_key() {
    [ -f "$ENV_FILE" ] || return 1
    from_file AGENT_API_KEY >/dev/null || from_file MINIMAX_API_KEY >/dev/null
}


ask() {                                 # ask PROMPT DEFAULT; -p writes to stderr,
    local answer                        # so only the answer is captured
    if [ -n "$2" ]; then
        read -r -p "  $1 [$2]: " answer
        printf '%s' "${answer:-$2}"
    else
        read -r -p "  $1: " answer
        printf '%s' "$answer"
    fi
}


ask_secret() {
    local answer
    read -rs -p "  $1: " answer
    printf '\n' >&2
    printf '%s' "$answer"
}


# Replace the three settings and leave every other line of the file alone: it
# may hold your own exports, comments, or a command that fetches the key.
merge_env() {                           # merge_env URL_LINE MODEL_LINE KEY_LINE
    # through the environment, not `awk -v`: -v expands backslash escapes, so a
    # key holding \n or ending in \ would be silently rewritten
    MA_URL=$1 MA_MODEL=$2 MA_KEY=$3 awk '
        BEGIN { url = ENVIRON["MA_URL"]; model = ENVIRON["MA_MODEL"]
                key = ENVIRON["MA_KEY"] }
        function put(text, seen) { if (!seen) print text }
        /^[[:space:]]*(export[[:space:]]+)?AGENT_BASE_URL=/ { put(url, u); u = 1; next }
        /^[[:space:]]*(export[[:space:]]+)?AGENT_MODEL=/    { put(model, m); m = 1; next }
        /^[[:space:]]*(export[[:space:]]+)?AGENT_API_KEY=/  { put(key, k); k = 1; next }
        { print }
        END { put(url, u); put(model, m); put(key, k) }
    '
}


fresh_env() {                           # fresh_env URL_LINE MODEL_LINE KEY_LINE
    cat <<'EOF'
# miniagent settings.  Sourced by the `agent` wrapper as shell, so command
# substitution works.  Anything already set in your shell wins over what is
# here.  Keep it private - it holds your API key.

EOF
    printf '%s\n%s\n%s\n' "$1" "$2" "$3"
    cat <<'EOF'

# A key out of a password manager works too:
# export AGENT_API_KEY=$(pass show minimax/api)

# The settings MiniMax measured M2.x at.  Leave them be unless you have a
# reason - drifting off them is the usual cause of flaky tool calls.
# export AGENT_TEMPERATURE=1.0
# export AGENT_TOP_P=0.95
# export AGENT_TOP_K=40
# export AGENT_MAX_TOKENS=16384

# export AGENT_THINKING=1     # show the model's reasoning
# export AGENT_YOLO=1         # auto-approve every `ask` (a `deny` still holds)
# export AGENT_POLICY=        # an extra rule file for every run
EOF
}


write_env_file() {                      # write_env_file URL MODEL KEY
    local dir tmp
    dir=$(dirname "$ENV_FILE")
    mkdir -p "$dir"
    tmp=$(mktemp "$dir/env.XXXXXX") || die "cannot write in $dir"
    # 600 before the key goes in: `> "$ENV_FILE"` would have kept an existing
    # file's mode, leaving the key world-readable until the chmod afterwards
    chmod 600 "$tmp"
    if [ -f "$ENV_FILE" ]; then
        merge_env "export AGENT_BASE_URL=$(shq "$1")" \
                  "export AGENT_MODEL=$(shq "$2")" \
                  "export AGENT_API_KEY=$(shq "$3")" < "$ENV_FILE" > "$tmp"
    else
        fresh_env "export AGENT_BASE_URL=$(shq "$1")" \
                  "export AGENT_MODEL=$(shq "$2")" \
                  "export AGENT_API_KEY=$(shq "$3")" > "$tmp"
    fi
    mv "$tmp" "$ENV_FILE"
}


setup_env() {
    local url model key had shown

    url=$(from_file AGENT_BASE_URL)  || url=${AGENT_BASE_URL:-https://api.minimax.io/v1}
    model=$(from_file AGENT_MODEL)   || model=${AGENT_MODEL:-MiniMax-M2.5}
    had=$(from_file AGENT_API_KEY)   || had=${AGENT_API_KEY:-${MINIMAX_API_KEY:-}}

    if interactive; then
        printf '\nsettings -> %s\n' "$ENV_FILE" >&2
        printf '  press enter to keep what is shown\n' >&2
        url=$(ask "endpoint" "$url")
        model=$(ask "model" "$model")
        if [ -n "$had" ]; then
            shown=$(mask "$had")
            key=$(ask_secret "api key (hidden; enter to keep $shown)")
            [ -n "$key" ] || key=$had
        else
            key=$(ask_secret "api key (hidden; enter to fill in later)")
        fi
    else                                # a pipe or a script: keep what is there
        key=$had
    fi

    write_env_file "$url" "$model" "$key"
    [ -n "$key" ] || printf '\nno key yet. Put one in with: %s\n' \
                            "\$EDITOR \"\$(agent --env)\"" >&2
}


shell_rc() {
    local sh=${SHELL:-/bin/sh}       # $SHELL is not guaranteed under `set -u`
    case ${sh##*/} in
        zsh)  printf '%s\n' "${ZDOTDIR:-$HOME}/.zshrc" ;;
        bash) [ -f "$HOME/.bash_profile" ] && [ ! -f "$HOME/.bashrc" ] \
                  && printf '%s\n' "$HOME/.bash_profile" \
                  || printf '%s\n' "$HOME/.bashrc" ;;
        *)    printf '%s\n' "$HOME/.profile" ;;
    esac
}


install_self() {
    local bindir=${1:-$HOME/.local/bin}
    local link=$bindir/agent
    mkdir -p "$bindir"

    if [ -e "$link" ] && [ ! -L "$link" ]; then
        die "$link exists and is not a symlink; move it out of the way first"
    fi
    ln -sfn "$SELF" "$link"
    printf 'linked  %s -> %s\n' "$link" "$SELF"

    # The command was called `miniagent` before, and that link points at the
    # old name next to this script - never at $SELF, which is now `agent`.
    # Anything else on PATH called miniagent is not ours to move.
    local stale=$bindir/miniagent
    if [ -L "$stale" ] && [ "$(readlink "$stale")" = "$(dirname "$SELF")/miniagent" ]; then
        rm -f "$stale"
        printf 'removed %s (the command is now `agent`)\n' "$stale"
    fi

    if [ ! -f "$ENV_FILE" ]; then
        setup_env
        printf 'wrote   %s\n' "$ENV_FILE"
    elif env_has_key; then
        printf 'kept    %s\n' "$ENV_FILE"
    else
        printf 'found   %s, but it has no API key\n' "$ENV_FILE"
        if interactive; then
            setup_env
        else
            printf '        put one in with: $EDITOR "$(agent --env)"\n'
        fi
    fi

    case ":$PATH:" in
        *":$bindir:"*)
            printf 'ready   %s is on your PATH\n' "$bindir"
            return ;;
    esac

    local rc line
    rc=$(shell_rc)
    line="export PATH=\"$bindir:\$PATH\""
    printf '\n%s is not on your PATH. Add this to %s:\n    %s\n' "$bindir" "$rc" "$line"
    if [ -t 0 ] && [ -t 1 ]; then
        local answer
        read -r -p "add it now? [y/N] " answer
        case $answer in
            y|Y|yes)
                printf '\n# added by agent --install\n%s\n' "$line" >> "$rc"
                printf 'added to %s; run: source %s\n' "$rc" "$rc" ;;
        esac
    fi
}


case ${1:-} in
    --install)  shift; install_self "${1:-}"; exit 0 ;;
    --init)     [ -f "$ENV_FILE" ] && die "$ENV_FILE already exists; edit it instead"
                setup_env; printf 'wrote %s\n' "$ENV_FILE"; exit 0 ;;
    --env)      printf '%s\n' "$ENV_FILE"; exit 0 ;;
    -h|--help)  usage; echo; exec "$PYTHON" "$HERE/agent.py" --help ;;
esac


# ---- settings ------------------------------------------------------------
if [ -n "${MINIAGENT_ENV:-}" ] && [ ! -f "$ENV_FILE" ]; then
    die "MINIAGENT_ENV=$ENV_FILE does not exist"
fi

if [ -f "$ENV_FILE" ]; then
    perms=$(stat -c %a "$ENV_FILE" 2>/dev/null || stat -f %Lp "$ENV_FILE" 2>/dev/null || echo 600)
    case $perms in
        *00) ;;
        *) printf 'agent: %s is readable by others; chmod 600 it\n' "$ENV_FILE" >&2 ;;
    esac

    # What the caller set explicitly outranks the file, so remember it first.
    declare -A preset=()
    while read -r name; do
        [ -n "$name" ] && preset[$name]=${!name}
    done < <(compgen -v 2>/dev/null | grep -E '^(AGENT_|MINIMAX_)' || true)

    set -a
    # shellcheck disable=SC1090
    . "$ENV_FILE"
    set +a

    if [ "${#preset[@]}" -gt 0 ]; then
        for name in "${!preset[@]}"; do export "$name=${preset[$name]}"; done
    fi
fi

exec "$PYTHON" "$HERE/agent.py" "$@"
